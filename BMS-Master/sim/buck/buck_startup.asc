TEXT 48 96 Left 2 ;TPS62933F buck: 12 V -> 6.5 V, start-up with a 1 A load.  Values = LCSC BOM.csv
TEXT 48 848 Left 2 !.include TPS62933F_LTspice.lib
TEXT 48 880 Left 2 !.options reltol=0.005 trtol=7 method=gear
TEXT 48 912 Left 2 !.save V(vout) V(vin) V(sw) V(ss) V(en) V(bst) V(fb) I(L1) I(Rh)
